extends ../../layouts/default.pug

block main 
  .container 
    .row 
      .col-3 
        if(product.title)
          h1(class="mb-4") #{product.title}
        if(product.price)
          div(class="mb-4") Giá: #{product.price}$
        if(product.stock)
          div(class="mb-4") Còn lại: #{product.stock}
        if(product.thumbnail)
          div(class="mb-4")
            img(
              src=product.thumbnail 
              width="100px"
              alt=product.title
            )
        if(product.description)
          div(class="mb-4") Mô tả: #{product.description}