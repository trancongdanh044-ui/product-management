extends ../../layouts/default.pug

block main
  h1(class="mb-4") Chi tiết sản phẩm
  if(product.title)
    div(class="mb-4") Tiêu đề: #{product.title}
  if(product.price)
    div(class="mb-4") Giá: #{product.price}$
  if(product.stock)
    div(class="mb-4") Còn lại: #{product.stock}
  if(product.thumbnail)
    div(class="mb-4") Ảnh:
      img(
        src=product.thumbnail 
        width="100px"
        alt=product.title
      )
  if(product.status && product.status == "active")
    div(class="mb-4") Trạng thái: <span class="badge badge-success"> Hoạt động</span>
  else 
    div(class="mb-4") Trạng thái: <span class="badge badge-danger"> Dừng hoạt động</span>
  if(product.position)
    div(class="mb-4") Vị trí: <b>#{product.position}</b>
  if(product.description)
    div(class="mb-4") Mô tả: #{product.description}

  a(
    href=`${prefixAdmin}/products/edit/${product.id}`
    class="btn btn-warning"
  ) Chỉnh sửa
  script(src="/admins/js/products.js")